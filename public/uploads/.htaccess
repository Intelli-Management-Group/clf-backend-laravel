# Uploaded files are served as static content only - never executed.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .phar
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|phps|cgi|pl|py)$">
    SetHandler none
    ForceType text/plain
</FilesMatch>

# Same CORS header the Express static middleware sent.
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
